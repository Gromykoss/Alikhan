{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Office Forward Payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string",
      "const": "hermes"
    },
    "platform": {
      "type": "string",
      "const": "whatsapp"
    },
    "chat_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "maxLength": 4000
    },
    "topic": {
      "type": "string",
      "enum": [
        "кровля",
        "наружка",
        "материалы",
        "смета",
        "общее"
      ]
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "source",
    "platform",
    "chat_id",
    "message_id",
    "from",
    "text",
    "topic"
  ]
}
